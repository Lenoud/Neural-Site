---
interface NavItem {
  name: string;
  slug?: string;
  order?: number;
  children?: NavItem[];
}

interface Props {
  items: NavItem[];
  currentSlug?: string;
}

const { items, currentSlug = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

function containsCurrent(item: NavItem): boolean {
  if (item.slug === currentSlug) return true;
  return item.children?.some(c => containsCurrent(c)) || false;
}

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function renderTree(items: NavItem[], parentPath = ''): string {
  return items.map(item => {
    if (item.children) {
      const isOpen = containsCurrent(item);
      const path = parentPath ? `${parentPath}/${item.name}` : item.name;
      return `<li>
        <details ${isOpen ? 'open' : ''} class="nav-folder" data-path="${escapeHtml(path)}">
          <summary class="nav-category">${escapeHtml(item.name)}</summary>
          <ul class="nav-list">${renderTree(item.children, path)}</ul>
        </details>
      </li>`;
    }
    const isActive = item.slug === currentSlug;
    return `<li>
      <a href="${base}notes/${item.slug}" class="nav-link${isActive ? ' active' : ''}">${escapeHtml(item.name)}</a>
    </li>`;
  }).join('');
}

const html = renderTree(items);
---

<ul class="nav-list" set:html={html} />

<style is:global>
  .nav-list { list-style: none; }
  .nav-list .nav-list { list-style: none; padding-left: 12px; }
  .nav-link {
    display: block;
    padding: 6px 12px;
    overflow-wrap: break-word;
    color: var(--text-secondary);
    border-radius: 4px;
    transition: background 0.15s;
    text-decoration: none;
  }
  .nav-link:hover { background: var(--bg-hover); color: var(--text-primary); }
  .nav-link.active { background: var(--bg-hover); color: var(--text-primary); }
  .nav-folder > summary {
    cursor: pointer;
    padding: 8px 12px;
    color: var(--text-muted);
    font-size: 13px;
    border-radius: 4px;
    transition: background 0.15s;
  }
  .nav-folder > summary:hover { background: var(--bg-hover); }
</style>

<script>
  const KEY = 'nav-open-folders';
  let saved = new Set<string>();
  try {
    saved = new Set(JSON.parse(sessionStorage.getItem(KEY) || '[]'));
  } catch { /* 损坏的存储数据，按空状态处理 */ }

  const folders = document.querySelectorAll<HTMLDetailsElement>('.sidebar-nav details.nav-folder');
  folders.forEach(d => {
    const path = d.dataset.path;
    if (!path) return;
    if (saved.has(path)) d.open = true;
    d.addEventListener('toggle', () => {
      if (d.open) saved.add(path); else saved.delete(path);
      sessionStorage.setItem(KEY, JSON.stringify([...saved]));
    });
  });

  document.querySelector('.sidebar-nav .nav-link.active')?.scrollIntoView({ block: 'center' });
</script>
