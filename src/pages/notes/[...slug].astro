---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageLayout from '../../components/PageLayout.astro';
import { getBacklinkIndex } from '../../utils/backlink-cache';
import { getLinkGraph } from '../../utils/link-graph';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const title = note.data.title || note.id.split('/').pop() || note.id;

const allNotes = await getCollection('notes');

const backlinkIndex = await getBacklinkIndex();

// 全站链接图整个构建只算一次（模块级缓存），每页只做 BFS
const { allLinks, neighborMap } = await getLinkGraph();

// BFS from current note, 3 layers
const bfsLayers: Set<string>[] = [];
{
  const visited = new Set<string>([note.id]);
  let frontier = new Set<string>([note.id]);
  for (let d = 0; d < 3; d++) {
    const next = new Set<string>();
    for (const id of frontier) {
      for (const n of (neighborMap.get(id) || [])) {
        if (!visited.has(n)) { visited.add(n); next.add(n); }
      }
    }
    bfsLayers.push(next);
    frontier = next;
  }
}

// Node info lookup
const nodeMap = new Map(allNotes.map(n => [n.id, { id: n.id, name: n.data.title || n.id.split('/').pop() || n.id }]));
nodeMap.set(note.id, { id: note.id, name: title });

const MAX_LOCAL_GRAPH_NODES = 30;

function buildGraphData(depth: number) {
  const ids = new Set<string>([note.id]);
  for (let i = 0; i < depth; i++) {
    for (const id of bfsLayers[i]) ids.add(id);
  }
  let nodes = [...ids].map(id => nodeMap.get(id)).filter(Boolean) as { id: string; name: string }[];
  if (nodes.length > MAX_LOCAL_GRAPH_NODES) {
    const kept = new Set([note.id, ...nodes.slice(1, MAX_LOCAL_GRAPH_NODES).map(n => n.id)]);
    nodes = nodes.filter(n => kept.has(n.id));
  }
  const finalIds = new Set(nodes.map(n => n.id));
  const links = allLinks.filter(l => finalIds.has(l.source) && finalIds.has(l.target));
  return { nodes, links };
}

const backlinks = backlinkIndex.get(note.id) || [];

const tocHeadings = headings
  ?.filter((h: any) => h.depth >= 1 && h.depth <= 3)
  .map((h: any) => ({ depth: h.depth, slug: h.slug, text: h.text })) || [];

const graphDataD1 = buildGraphData(1);
const graphDataD2 = buildGraphData(2);
const graphDataD3 = buildGraphData(3);
---

<Layout title={title}>
  <PageLayout
    title={title}
    currentSlug={note.id}
    headings={tocHeadings}
    backlinks={backlinks}
    graphDataD1={graphDataD1}
    graphDataD2={graphDataD2}
    graphDataD3={graphDataD3}
    currentId={note.id}
    metadata={{
      作者: note.data.作者,
      创建日期: note.data.创建日期 ? new Date(note.data.创建日期).toLocaleDateString('zh-CN') : undefined,
      修改日期: note.data.修改日期 ? new Date(note.data.修改日期).toLocaleDateString('zh-CN') : undefined,
    }}
  >
    <Content />
  </PageLayout>
</Layout>
